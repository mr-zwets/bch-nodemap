[Unit]
Description=bch-nodemap web server (Nuxt)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=nodemap
Group=nodemap
# a copied build, switched by deploy.sh via the symlink; the checkout can rebuild freely
WorkingDirectory=/var/lib/nodemap/web/current
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=3000
Environment=DATABASE_URL=postgres://nodemap@/nodemap?host=/var/run/postgresql
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# a blocked syscall fails with EPERM instead of killing the process
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
