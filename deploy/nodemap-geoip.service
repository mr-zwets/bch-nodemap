[Unit]
Description=Refresh DB-IP Lite GeoIP databases for the bch-nodemap crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=30min
User=nodemap
Group=nodemap
WorkingDirectory=/opt/bch-nodemap
ExecStart=/opt/bch-nodemap/scripts/geoip.sh
# Only runs when geoip.sh succeeded (it fails if nothing was updated). The crawler
# opens the .mmdb files at start; "+" runs this fixed command as root.
ExecStartPost=+/usr/bin/systemctl try-restart nodemap-crawler.service
